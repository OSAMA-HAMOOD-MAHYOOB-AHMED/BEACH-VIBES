# Copy this file to .env and fill in values before running the backend.

# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, NEVER expose this to a browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=4000
# Origin(s) allowed to call this API — the Vite dev server by default.
CORS_ORIGIN=http://localhost:5173

# Optional — powers the AI shopping assistant chat widget. Without it, the
# chat still opens but replies with a "not configured" message.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
